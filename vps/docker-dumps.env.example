# Copiar a /etc/osigc/docker-dumps.env y dejar en root:root 600.
# Aquí NO van contraseñas: pg_dump usa el socket local del contenedor.

# Postgres (nombres reales: `docker ps`, `docker exec postgres16 psql -U <user> -l`)
PG_CONTAINER=postgres16
PG_USER=odoo
PG_DBS="CAMBIAR_bd_odoo CAMBIAR_bd_n8n"

# Odoo: filestore dentro del contenedor (vacío = omitir)
ODOO_CONTAINER=odoo19
ODOO_FILESTORE=/var/lib/odoo/filestore

# n8n: carpeta de datos dentro del contenedor (incluye encryptionKey)
N8N_CONTAINER=n8n
N8N_DATA=/home/node/.n8n

# Definición del stack (compose + .env), se cifra
COMPOSE_DIRS="/opt/odoo19 /opt/osigc /opt/n8n"

# Clave PÚBLICA age (age-keygen en tu Mac; la privada NUNCA en el VPS)
AGE_RECIPIENT=age1CAMBIAR

# Carpeta dentro del home del usuario Hestia → la incluye v-backup-users
OUT_DIR=/home/user/private/docker-dumps
OUT_OWNER=user

# No volcar si el disco supera este % (Hestia aborta backups al 95%)
MAX_DISK_PCT=85

# Opcional: ping de healthchecks.io (URL completa del check)
HC_URL=
